# ===========================================
# 政策情报系统 - 环境变量配置
# 复制此文件为 .env 并修改配置
# ===========================================

# AI API 配置（支持 OpenAI / DeepSeek / 中转站 等兼容格式）
# 中转站示例：AI_API_BASE=https://api.your-relay.com/v1
AI_API_KEY=
AI_API_BASE=https://api.deepseek.com
AI_MODEL=deepseek-chat


# AI 请求可靠性参数（单位：秒/次）
# 单次请求超时；应用层重试，SDK 内部重试已关闭，避免双重重试放大时延。
AI_REQUEST_TIMEOUT_SECONDS=300
# 首次失败后的额外重试次数；总请求次数 = 重试次数 + 1。
AI_MAX_RETRIES=2
# 单次请求耗时达到该阈值时输出慢请求告警，不中断请求。
AI_SLOW_THRESHOLD_SECONDS=60

# Docker 构建加速（可选；国内服务器建议使用镜像源）
APT_MIRROR=http://deb.debian.org/debian
APT_SECURITY_MIRROR=http://deb.debian.org/debian-security
PIP_INDEX_URL=https://pypi.org/simple

# 数据库
DATABASE_URL=sqlite:///data/policies.db
# PostgreSQL 示例（请通过环境变量注入真实密码，不要把生产凭据写入仓库）：
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/policy_intelligence

# 邮件推送配置（可选）
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
NOTIFY_CHANNELS=
FEISHU_WEBHOOK_URL=
# 企业微信群机器人 Webhook（单向通知；不是企业微信智能机器人 Secret）
WECHAT_WEBHOOK_URL=

# 飞书自建应用双向消息（与上方群机器人 Webhook 相互独立）
# 在飞书开放平台启用机器人、配置事件 im.message.receive_v1 后填写。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# 逗号分隔的 open_id 白名单；为空时双向机器人拒绝所有用户消息。
FEISHU_ALLOWED_USER_IDS=
# 机器人 open_id；群聊中用于识别 @机器人。未设置时群聊只能使用命令前缀。
FEISHU_BOT_OPEN_ID=
FEISHU_COMMAND_PREFIX=/政策

# 企业微信"智能机器人"（API 模式，WebSocket 长连接）
# 与下方自建应用是两套独立产品：只需 BotID + Secret，
# 无需公网回调 URL，也无需自行处理消息加解密。
WECOM_BOT_ENABLED=false
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 逗号分隔的成员 userid 白名单；为空时拒绝所有用户消息。
WECOM_BOT_ALLOWED_USER_IDS=

# 企业微信自建应用双向消息
# 注意：上方的企业微信群机器人 Webhook 是单向通知，不能用于接收用户消息。
# 双向对话必须在企业微信管理后台创建"自建应用"，并把回调地址指向
# GET/POST /webhooks/wecom/events，回调地址必须是企业微信可访问的公网 HTTPS。
WECOM_CORP_ID=
WECOM_CORP_SECRET=
# 未启用自建应用时留空；启用时填写企业微信后台的整数 AgentID。
WECOM_AGENT_ID=
# 回调 Token 与 EncodingAESKey 在自建应用"接收消息"页面生成，
# EncodingAESKey 固定 43 位；缺失或长度不对时服务会拒绝所有回调。
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
# 逗号分隔的成员 userid 白名单；为空时拒绝所有用户消息。
WECOM_ALLOWED_USER_IDS=
# 群聊中用于触发 Agent 的命令前缀，避免普通闲聊误触发。
WECOM_COMMAND_PREFIX=/政策

# 通知 pending 租约时长（秒）。进程崩溃后超过该时长才允许自动接管；
# 必须明显大于单次 SMTP/HTTP 30 秒超时，默认 300 秒。
NOTIFICATION_PENDING_TIMEOUT_SECONDS=300

# 数据源连续失败告警开关（true 开启，false 关闭；本机调试建议 false 以避免误发通知）
SOURCE_HEALTH_ALERT_ENABLED=false

# 采集与 AI 分析运行参数
COLLECT_CONTENT_LIMIT=10
ANALYZE_CONCURRENCY=3

# Tavily（武汉市政策发现所需的搜索 API）
TAVILY_API_KEY=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
